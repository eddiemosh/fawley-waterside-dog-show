{
  "version": 2,
  "builds": [
    {
      "src": "v2/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/static/(.*)$", "dest": "/v2/static/$1" },
    { "src": "^/(.*)$", "dest": "/v2/index.html" }
  ]
}
