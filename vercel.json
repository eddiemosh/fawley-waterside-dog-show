{
  "version": 2,
  "projectSettings": {
    "framework": "create-react-app"
  },
  "builds": [
    {
      "src": "v2/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "outputDirectory": "v2/build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
